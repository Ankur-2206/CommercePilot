# MySQL connection string. Do not commit your real .env file.
DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@localhost:3306/commercepilot

# Razorpay test/live credentials from the Razorpay dashboard.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Groq credential used by the product-discovery agent.
GROQ_API_KEY=replace_me
